{
  "type": "object",
  "additionalProperties": false,
  "required": ["context", "research", "narrative", "slides", "review", "sources"],
  "properties": {
    "context": { "$ref": "#/$defs/context" },
    "research": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/research" } },
    "narrative": { "$ref": "#/$defs/narrative" },
    "slides": { "type": "array", "minItems": 11, "maxItems": 11, "items": { "$ref": "#/$defs/slide" } },
    "review": { "$ref": "#/$defs/review" },
    "sources": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "text200": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": ".*\\S.*" },
    "text500": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": ".*\\S.*" },
    "text1000": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": ".*\\S.*" },
    "text2000": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": ".*\\S.*" },
    "text4000": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": ".*\\S.*" },
    "text6000": { "type": "string", "minLength": 1, "maxLength": 6000, "pattern": ".*\\S.*" },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["seller", "primaryBuyer", "supportingBuyer", "salesStage", "objective", "evidencePosture"],
      "properties": {
        "seller": { "$ref": "#/$defs/text500" }, "primaryBuyer": { "$ref": "#/$defs/text500" },
        "supportingBuyer": { "$ref": "#/$defs/text500" }, "salesStage": { "$ref": "#/$defs/text500" },
        "objective": { "$ref": "#/$defs/text4000" }, "evidencePosture": { "$ref": "#/$defs/text4000" }
      }
    },
    "research": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "summary", "evidence"],
      "properties": {
        "id": { "enum": ["company_positioning", "product_technical", "executive_buyer", "technical_buyer", "market_alternatives", "proof_claims", "skeptical_review"] },
        "summary": { "$ref": "#/$defs/text6000" },
        "evidence": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claim", "sourceIds", "evidenceClass", "confidence", "buyerImplication", "safeUse"],
      "properties": {
        "id": { "$ref": "#/$defs/text200" }, "claim": { "$ref": "#/$defs/text6000" },
        "sourceIds": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/text200" } },
        "evidenceClass": { "enum": ["verified_fact", "company_claim", "field_signal", "inference"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "buyerImplication": { "$ref": "#/$defs/text2000" }, "safeUse": { "$ref": "#/$defs/text2000" }
      }
    },
    "narrative": {
      "type": "object", "additionalProperties": false,
      "required": ["situation", "complication", "resolution", "slideRationale"],
      "properties": {
        "situation": { "$ref": "#/$defs/text6000" }, "complication": { "$ref": "#/$defs/text6000" },
        "resolution": { "$ref": "#/$defs/text6000" },
        "slideRationale": { "type": "array", "minItems": 11, "maxItems": 11, "items": { "$ref": "#/$defs/rationale" } }
      }
    },
    "rationale": {
      "type": "object", "additionalProperties": false, "required": ["slideId", "rationale"],
      "properties": { "slideId": { "$ref": "#/$defs/text200" }, "rationale": { "$ref": "#/$defs/text2000" } }
    },
    "slide": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "number", "purpose", "headline", "bodyBullets", "speakerNotes", "evidenceIds", "proofState"],
      "properties": {
        "id": { "$ref": "#/$defs/text200" }, "number": { "type": "integer", "minimum": 1, "maximum": 11 },
        "purpose": { "enum": ["problem", "cost", "shift", "approach", "workflow", "proof", "case_study", "implementation", "roi", "pricing", "cta"] },
        "headline": { "$ref": "#/$defs/text500" },
        "bodyBullets": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/text1000" } },
        "speakerNotes": { "$ref": "#/$defs/text6000" },
        "evidenceIds": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/text200" } },
        "proofState": { "enum": ["verified", "company_claim", "inference", "unresolved"] }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["checks", "warnings", "blockingGaps", "doNotOverclaim"],
      "properties": {
        "checks": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/check" } },
        "warnings": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text2000" } },
        "blockingGaps": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text2000" } },
        "doNotOverclaim": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text2000" } }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "status", "detail"],
      "properties": {
        "id": { "enum": ["buyer_relevance", "story_arc", "business_outcome", "scanability", "proof", "pricing_posture", "next_step"] },
        "label": { "$ref": "#/$defs/text200" }, "status": { "enum": ["passed", "warning", "blocked"] }, "detail": { "$ref": "#/$defs/text2000" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "locator", "sourceClass", "asOf"],
      "properties": {
        "id": { "$ref": "#/$defs/text200" }, "title": { "$ref": "#/$defs/text500" }, "locator": { "$ref": "#/$defs/text2000" },
        "sourceClass": { "enum": ["local_context", "company_source", "third_party", "inference"] },
        "asOf": { "type": "string", "minLength": 1, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  }
}
