{
  "type": "object",
  "additionalProperties": false,
  "required": ["context", "research", "narrative", "slides", "review", "sources"],
  "properties": {
    "context": { "$ref": "#/$defs/context" },
    "research": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/research" } },
    "narrative": { "$ref": "#/$defs/narrative" },
    "slides": { "type": "array", "minItems": 11, "maxItems": 11, "items": { "$ref": "#/$defs/slide" } },
    "review": { "$ref": "#/$defs/review" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["seller", "primaryBuyer", "supportingBuyer", "salesStage", "objective", "evidencePosture"],
      "properties": {
        "seller": { "$ref": "#/$defs/nonEmpty" }, "primaryBuyer": { "$ref": "#/$defs/nonEmpty" },
        "supportingBuyer": { "$ref": "#/$defs/nonEmpty" }, "salesStage": { "$ref": "#/$defs/nonEmpty" },
        "objective": { "$ref": "#/$defs/nonEmpty" }, "evidencePosture": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "research": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "summary", "evidence"],
      "properties": {
        "id": { "enum": ["company_positioning", "product_technical", "executive_buyer", "technical_buyer", "market_alternatives", "proof_claims", "skeptical_review"] },
        "summary": { "$ref": "#/$defs/nonEmpty" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claim", "sourceIds", "evidenceClass", "confidence", "buyerImplication", "safeUse"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "claim": { "$ref": "#/$defs/nonEmpty" },
        "sourceIds": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "evidenceClass": { "$ref": "#/$defs/nonEmpty" }, "confidence": { "$ref": "#/$defs/nonEmpty" },
        "buyerImplication": { "$ref": "#/$defs/nonEmpty" }, "safeUse": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "narrative": {
      "type": "object", "additionalProperties": false,
      "required": ["situation", "complication", "resolution", "slideRationale"],
      "properties": {
        "situation": { "$ref": "#/$defs/nonEmpty" }, "complication": { "$ref": "#/$defs/nonEmpty" },
        "resolution": { "$ref": "#/$defs/nonEmpty" },
        "slideRationale": { "type": "array", "minItems": 11, "maxItems": 11, "items": { "$ref": "#/$defs/rationale" } }
      }
    },
    "rationale": {
      "type": "object", "additionalProperties": false, "required": ["slideId", "rationale"],
      "properties": { "slideId": { "$ref": "#/$defs/nonEmpty" }, "rationale": { "$ref": "#/$defs/nonEmpty" } }
    },
    "slide": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "number", "purpose", "headline", "bodyBullets", "speakerNotes", "evidenceIds", "proofState"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "number": { "type": "integer", "minimum": 1, "maximum": 11 },
        "purpose": { "enum": ["problem", "cost", "shift", "approach", "workflow", "proof", "case_study", "implementation", "roi", "pricing", "cta"] },
        "headline": { "$ref": "#/$defs/nonEmpty" },
        "bodyBullets": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/nonEmpty" } },
        "speakerNotes": { "$ref": "#/$defs/nonEmpty" },
        "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "proofState": { "enum": ["verified", "company_claim", "inference", "unresolved"] }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["checks", "warnings", "blockingGaps", "doNotOverclaim"],
      "properties": {
        "checks": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/check" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "blockingGaps": { "type": "array", "items": { "type": "string" } },
        "doNotOverclaim": { "type": "array", "items": { "type": "string" } }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "status", "detail"],
      "properties": {
        "id": { "enum": ["buyer_relevance", "story_arc", "business_outcome", "scanability", "proof", "pricing_posture", "next_step"] },
        "label": { "$ref": "#/$defs/nonEmpty" }, "status": { "enum": ["passed", "warning", "blocked"] }, "detail": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "locator", "sourceClass", "asOf"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "title": { "$ref": "#/$defs/nonEmpty" }, "locator": { "$ref": "#/$defs/nonEmpty" },
        "sourceClass": { "enum": ["local_context", "company_source", "third_party", "inference"] },
        "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  }
}
